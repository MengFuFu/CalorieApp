<?xml version="1.0" encoding="utf-8"?><!--
  4 个顶层目的地。这里没有 action，因为 Tab 之间是平级切换，
  直接在代码里 navigate(destinationId, args, options) 即可，不需要预声明连线。
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.mh.calorie.ui.home.HomeFragment"
        android:label="@string/page_title_home">

        <!-- 首页「体重」卡 / 「记体重」按钮都走这一条 -->
        <action
            android:id="@+id/action_homeFragment_to_weightRecordFragment"
            app:destination="@id/weightRecordFragment" />

        <action
            android:id="@+id/action_homeFragment_to_sportRecordFragment"
            app:destination="@id/sportRecordFragment" />

        <action
            android:id="@+id/action_homeFragment_to_sportLibraryFragment"
            app:destination="@id/sportLibraryFragment" />

        <action
            android:id="@+id/action_homeFragment_to_waterFragment"
            app:destination="@id/waterFragment" />

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/weightRecordFragment"
        android:name="com.mh.calorie.ui.weight.record.WeightRecordFragment"
        android:label="@string/weight_record_title">

        <!-- 历史体重「查看更多」 -->
        <action
            android:id="@+id/action_weightRecordFragment_to_weightHistoryFragment"
            app:destination="@id/weightHistoryFragment" />

        <action
            android:id="@+id/action_weightRecordFragment_to_bodyHistoryFragment"
            app:destination="@id/bodyHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/weightHistoryFragment"
        android:name="com.mh.calorie.ui.weight.history.WeightHistoryFragment"
        android:label="@string/weight_history_title" />
    <fragment
        android:id="@+id/bodyHistoryFragment"
        android:name="com.mh.calorie.ui.weight.history.BodyHistoryFragment"
        android:label="@string/body_history_title" />

    <fragment
        android:id="@+id/planFragment"
        android:name="com.mh.calorie.ui.plan.PlanFragment"
        android:label="@string/page_title_plan" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.mh.calorie.ui.stats.StatsFragment"
        android:label="@string/page_title_stats">

        <action
            android:id="@+id/action_statsFragment_to_foodLibraryFragment"
            app:destination="@id/foodLibraryFragment" />

        <action
            android:id="@+id/action_statsFragment_to_lifeFoodDetailFragment"
            app:destination="@id/lifeFoodDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mh.calorie.ui.profile.ProfileFragment"
        android:label="@string/page_title_profile">

        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/sportRecordFragment"
        android:name="com.mh.calorie.ui.sport.SportRecordFragment"
        android:label="@string/sport_record_title">

        <action
            android:id="@+id/action_sportRecordFragment_to_sportLibraryFragment"
            app:destination="@id/sportLibraryFragment" />
    </fragment>

    <fragment
        android:id="@+id/sportLibraryFragment"
        android:name="com.mh.calorie.ui.sport.SportLibraryFragment"
        android:label="@string/sport_library_title">

        <action
            android:id="@+id/action_sportLibraryFragment_to_customSportFragment"
            app:destination="@id/customSportFragment" />
    </fragment>

    <fragment
        android:id="@+id/customSportFragment"
        android:name="com.mh.calorie.ui.sport.CustomSportFragment"
        android:label="@string/custom_sport_title">
        <argument
            android:name="dummy"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/waterFragment"
        android:name="com.mh.calorie.ui.water.WaterFragment"
        android:label="@string/water_title" />

    <fragment
        android:id="@+id/foodLibraryFragment"
        android:name="com.mh.calorie.ui.food.FoodLibraryFragment"
        android:label="@string/food_title">

        <action
            android:id="@+id/action_foodLibraryFragment_to_customFoodFragment"
            app:destination="@id/customFoodFragment" />
    </fragment>

    <fragment
        android:id="@+id/customFoodFragment"
        android:name="com.mh.calorie.ui.food.CustomFoodFragment"
        android:label="@string/custom_food_title" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.mh.calorie.ui.auth.LoginFragment"
        android:label="@string/auth_action_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mh.calorie.ui.auth.RegisterFragment"
        android:label="@string/auth_action_register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/lifeFoodDetailFragment"
        android:name="com.mh.calorie.ui.stats.LifeFoodDetailFragment"
        android:label="@string/stats_life_title"
        tools:layout="@layout/fragment_life_food_detail" />
</navigation>