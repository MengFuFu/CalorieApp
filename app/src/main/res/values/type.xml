<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      字号层级说明（Material 的命名和我们的设计对不上，所以自定义一套）：
        Display  → 页面里最大的那个数字，如「2204 kcal」
        Title    → 页面标题「今日记录」
        CardTitle→ 卡片标题「饮食」「体重」
        Body     → 正文标签「食物摄入」
        Caption  → 辅助说明「目标 59.9 公斤」
        PillLabel→ 胶囊按钮里的字
      中文不设 letterSpacing（默认字距在中文里会显得松散），统一压成 0。
    -->

    <style name="TextAppearance.Momo.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.TitlePage" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.NumberMedium" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.PillLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 总卡里的大数字：实测 34sp，比 Display(38sp) 小一档 -->
    <style name="TextAppearance.Momo.CardNumber" parent="TextAppearance.Momo.Display">
        <item name="android:textSize">34sp</item>
    </style>

    <!-- 13sp 正文：食物摄入 / 0kcal / 0/284.76g 这一档 -->
    <style name="TextAppearance.Momo.BodySmall" parent="TextAppearance.Momo.Body">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Momo.TitleBar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Momo.NumberHuge" parent="TextAppearance.Momo.Display">
        <item name="android:textSize">44sp</item>
    </style>

</resources>