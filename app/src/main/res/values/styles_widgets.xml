<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== 卡片 ==================== -->
    <style name="Widget.Momo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <!-- 设计里卡片是「平铺 + 描边」而不是浮起来的，所以取消阴影 -->
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <!-- 首页总卡：更大圆角 + 绿色描边，M6 会用 -->
    <style name="Widget.Momo.Card.Outlined" parent="Widget.Momo.Card">
        <item name="cardCornerRadius">@dimen/radius_card_lg</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/brand_green</item>
        <item name="cardBackgroundColor">@color/bg_page</item>
    </style>

    <!-- ==================== 胶囊按钮 ==================== -->
    <!--
      三个关键点，缺一个就会长得不像设计稿：
        1. insetTop/insetBottom 设为 0：M3 按钮默认有 6dp 内缩，不清掉高度压不到 30dp
        2. minHeight + paddingTop=0：高度由 minHeight 决定，不再被文字撑开
        3. shapeAppearanceOverlay 指向 50% 圆角，才是胶囊形
    -->
    <style name="Widget.Momo.Button.Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/pill_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/pill_padding_h</item>
        <item name="android:paddingRight">@dimen/pill_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAppearance">@style/TextAppearance.Momo.PillLabel</item>
        <item name="android:textColor">@color/brand_green</item>
        <!-- 关键改动：内部填充显式给纯白，不再用 @null 指望透明 -->
        <item name="android:background">@null</item>
        <item name="backgroundTint">@color/pill_fill</item>
        <item name="strokeColor">@color/brand_green</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Momo.Pill</item>
        <item name="rippleColor">@color/brand_green_surface</item>
    </style>

    <!-- 橙色变体：记体重 -->
    <style name="Widget.Momo.Button.Pill.Orange" parent="Widget.Momo.Button.Pill">
        <item name="android:textColor">@color/accent_orange</item>
        <item name="strokeColor">@color/accent_orange</item>
        <item name="rippleColor">#1FF0A04B</item>
    </style>

    <!-- 蓝色变体：记喝水 -->
    <style name="Widget.Momo.Button.Pill.Blue" parent="Widget.Momo.Button.Pill">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="strokeColor">@color/accent_blue</item>
        <item name="rippleColor">#1F5B9BFF</item>
    </style>

    <!-- 实心绿色变体：AI 拍照识别等主行动按钮 -->
    <style name="Widget.Momo.Button.Pill.Filled" parent="Widget.Momo.Button.Pill">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/brand_green</item>
    </style>

    <!-- 小胶囊：首页功能卡内联按钮（记体重 / 记运动 / 记断食 / 记喝水）
     设计稿实测：外框 61.6×31.1dp、描边 1dp、文字 13sp、左右内边距 12dp -->
    <style name="Widget.Momo.Button.Pill.Compact" parent="Widget.Momo.Button.Pill">
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- 大胶囊：AI 拍照识别
     设计稿实测：外框 168.9×38.2dp、文字 16sp、左右内边距 44dp -->
    <style name="Widget.Momo.Button.Pill.Large" parent="Widget.Momo.Button.Pill">
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">44dp</item>
        <item name="android:paddingRight">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.Momo.KeypadKey" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_keypad_key</item>   <!-- 改这里 -->
    </style>

    <!-- 说明弹窗：宽度固定 84% 屏宽，背景透明由卡片自己画 -->
    <style name="Theme.Momo.Dialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">84%</item>
        <item name="android:windowMinWidthMinor">84%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <!-- 运动面板数字键 -->
    <style name="Widget.Momo.SportKey" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_sport_key</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- 日历星期表头：7 个等宽 TextView 共用 -->
    <!-- parent="" 不能省：style 名带点会被当隐式父样式去找 Widget.Momo，找不到就报错 -->
    <style name="Widget.Momo.WeekDay" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 顶部下拉面板：透明底 + 从上方滑入 -->
    <style name="Theme.Momo.TopSheet" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@style/Animation.Momo.TopSheet</item>
    </style>

    <style name="Animation.Momo.TopSheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_top</item>
        <item name="android:windowExitAnimation">@anim/slide_out_top</item>
    </style>

    <!-- 我的页每一行：56dp 高、左右 16dp、点击有水波纹 -->
    <style name="Widget.Momo.ProfileRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- NEW / HOT 小标签 -->
    <style name="Widget.Momo.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:background">@drawable/bg_badge_new</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 需要给 SectionTitle 加一个样式，或在 styles_widgets.xml 里加 -->
    <style name="Widget.Momo.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>