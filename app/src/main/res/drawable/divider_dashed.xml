<?xml version="1.0" encoding="utf-8"?>
<!--
  虚线分隔。注意：shape=line + dashWidth 在硬件加速下经常画不出来，
  使用处必须加 android:layerType="software"（下面 fragment_home.xml 里已经加了）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1dp"
        android:color="@color/divider"
        android:dashGap="4dp"
        android:dashWidth="4dp" />
</shape>