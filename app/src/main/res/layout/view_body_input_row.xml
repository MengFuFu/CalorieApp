<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_body_cell"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_body_waist" />

    <TextView
        android:id="@+id/tvRowLabel"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="腰围" />

    <!-- 把输入框推到右侧 -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <EditText
        android:id="@+id/etRowValue"
        android:layout_width="146dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_input_round"
        android:gravity="center"
        android:hint="@string/body_input_hint"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLength="5"
        android:paddingHorizontal="@dimen/space_8"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:text="@string/body_unit_cm"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>