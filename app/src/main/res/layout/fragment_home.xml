<?xml version="1.0" encoding="utf-8"?>
<!--
  首页。结构：底层是滚动内容，上层是固定标题。
  滚动内容用 paddingTop 让开标题高度，滚动时从标题下面穿过、被标题的不透明底色挡住 ——
  这就是截图里「卡片被标题裁掉一半」的效果，不是整页滚动。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/home_header_height"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="32dp">

            <!-- ==================== 今日总卡 ==================== -->
            <FrameLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_summary">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="14dp"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/card_padding">

                        <!--  剩余热量  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="@string/home_remaining"
                                android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:layout_marginBottom="6dp"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.Momo.Caption"
                                android:textColor="@color/text_tertiary" />

                            <!-- 演示数据：M4 数据层接上后由 ViewModel 提供 -->
                            <TextView
                                android:id="@+id/tvRemainingKcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:text="2204"
                                android:textAppearance="@style/TextAppearance.Momo.CardNumber" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:layout_marginBottom="8dp"
                                android:text="@string/unit_kcal"
                                android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!--  弧形仪表 - -->
                        <!-- 只放弧和吉祥物占位；文字拆到下面单独一行，弧的两端就悬在文字上方 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/home_gauge_height"
                            android:layout_marginTop="@dimen/space_4">

                            <com.mh.calorie.ui.widget.ArcGaugeView
                                android:id="@+id/arcGauge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- 吉祥物占位：暂不做角色，位置先留着 -->
                            <View
                                android:id="@+id/mascotPlaceholder"
                                android:layout_width="@dimen/home_mascot_size"
                                android:layout_height="@dimen/home_mascot_size"
                                android:layout_gravity="center_horizontal|top"
                                android:layout_marginTop="@dimen/space_8" />
                        </FrameLayout>

                        <!--  食物摄入 / 运动燃烧  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/llIntake"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvIntakeLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_intake"
                                    android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvIntakeKcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0kcal"
                                    android:textAppearance="@style/TextAppearance.Momo.Body"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llBurned"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvBurnedLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_burned"
                                    android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvBurnedKcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0kcal"
                                    android:textAppearance="@style/TextAppearance.Momo.Body"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 点击 AI 角色与我聊天  -->
                        <TextView
                            android:id="@+id/tvAiChatHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:gravity="center_horizontal"
                            android:text="@string/home_ai_chat_hint"
                            android:textAppearance="@style/TextAppearance.Momo.Caption"
                            android:textColor="@color/text_tertiary" />

                        <!--  虚线  -->
                        <com.mh.calorie.ui.widget.DashedDividerView
                            android:id="@+id/dividerMacro"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/space_12" />

                        <!--- 宏量三列  -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_macro_carb"
                                    android:textAppearance="@style/TextAppearance.Momo.Body" />

                                <ProgressBar
                                    android:id="@+id/pbCarb"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/progress_height"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:max="100"
                                    android:maxHeight="@dimen/progress_height"
                                    android:minHeight="@dimen/progress_height"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_macro" />

                                <TextView
                                    android:id="@+id/tvCarbValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="0/284.76g"
                                    android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_macro_protein"
                                    android:textAppearance="@style/TextAppearance.Momo.Body" />

                                <ProgressBar
                                    android:id="@+id/pbProtein"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/progress_height"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:max="100"
                                    android:maxHeight="@dimen/progress_height"
                                    android:minHeight="@dimen/progress_height"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_macro" />

                                <TextView
                                    android:id="@+id/tvProteinValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="0/114.96g"
                                    android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_macro_fat"
                                    android:textAppearance="@style/TextAppearance.Momo.Body" />

                                <ProgressBar
                                    android:id="@+id/pbFat"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/progress_height"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:max="100"
                                    android:maxHeight="@dimen/progress_height"
                                    android:minHeight="@dimen/progress_height"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/progress_macro" />

                                <TextView
                                    android:id="@+id/tvFatValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="0/68.77g"
                                    android:textAppearance="@style/TextAppearance.Momo.BodySmall"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 日期缎带：左下长斜尾、右上圆角压住描边、右下凹弧落进边框 -->
                    <com.mh.calorie.ui.widget.DateRibbonView
                        android:id="@+id/tvDateRibbon"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="1.5dp"
                        android:layout_marginEnd="1.5dp"
                        android:gravity="center_vertical"
                        android:paddingStart="66dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="16dp"
                        android:text="2026年11月15日"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <!-- ==================== 饮食卡 ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMeal"
                style="@style/Widget.Momo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_box_size"
                            android:layout_height="@dimen/icon_box_size"
                            android:background="@drawable/bg_icon_chip"
                            android:backgroundTint="@color/chip_orange"
                            android:contentDescription="@string/home_meal"
                            android:padding="5dp"
                            android:src="@drawable/ic_bowl" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/home_meal"
                            android:textAppearance="@style/TextAppearance.Momo.CardTitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_8"
                        android:contentDescription="@string/home_ai_photo"
                        android:src="@drawable/ic_camera_ai" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiPhoto"
                        style="@style/Widget.Momo.Button.Pill.Large"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/home_ai_photo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 第 1 行：我可以吃吗 / 食物PK ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_row1_height"
                android:layout_marginTop="@dimen/card_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCanIEat"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_box_size"
                                android:layout_height="@dimen/icon_box_size"
                                android:background="@drawable/bg_icon_chip"
                                android:backgroundTint="@color/chip_yellow"
                                android:contentDescription="@string/home_tool_can_i_eat"
                                android:padding="5dp"
                                android:src="@drawable/ic_search_food" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_tool_can_i_eat"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/home_tool_can_i_eat_desc"
                            android:textAppearance="@style/TextAppearance.Momo.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFoodPk"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- VS 底托：用两个带颜色的字母拼出来，比画矢量图更准 -->
                            <LinearLayout
                                android:layout_width="@dimen/icon_box_size"
                                android:layout_height="@dimen/icon_box_size"
                                android:background="@drawable/bg_icon_chip"
                                android:backgroundTint="@color/chip_green"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_vs"/>

                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_tool_food_pk"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/home_tool_food_pk_desc"
                            android:textAppearance="@style/TextAppearance.Momo.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ==================== 第 2 行：体重 / 运动 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_row2_height"
                android:layout_marginTop="@dimen/card_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeight"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/home_weight"
                                android:src="@drawable/ic_scale" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_weight"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWeight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="52.0"
                                android:textAppearance="@style/TextAppearance.Momo.NumberMedium" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRecordWeight"
                                style="@style/Widget.Momo.Button.Pill.Compact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_action_weight"
                                android:textColor="@color/accent_orange"
                                app:strokeColor="@color/accent_orange" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvWeightTarget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="目标59.9公斤"
                            android:textAppearance="@style/TextAppearance.Momo.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSport"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_dumbbell" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_sport"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- 数字和 kcal 单位要底部对齐，所以这里拆成两个 TextView -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvSportKcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.Momo.NumberMedium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="@string/unit_kcal"
                                    android:textAppearance="@style/TextAppearance.Momo.Caption" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRecordSport"
                                style="@style/Widget.Momo.Button.Pill.Compact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_action_sport" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/home_sport_today"
                            android:textAppearance="@style/TextAppearance.Momo.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ==================== 第 3 行：断食 / 喝水 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_row3_height"
                android:layout_marginTop="@dimen/card_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFasting"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_fasting" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_fasting"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_fasting_hint"
                                android:textAppearance="@style/TextAppearance.Momo.Caption" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRecordFasting"
                                style="@style/Widget.Momo.Button.Pill.Compact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:text="@string/home_action_fasting" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWater"
                    style="@style/Widget.Momo.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_water_cup" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/home_water"
                                android:textAppearance="@style/TextAppearance.Momo.CardTitle" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWaterMl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Momo.NumberMedium" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRecordWater"
                                style="@style/Widget.Momo.Button.Pill.Compact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_action_water"
                                android:textColor="@color/accent_blue"
                                app:strokeColor="@color/accent_blue" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWaterTarget"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="目标 1650 ml"
                                android:textAppearance="@style/TextAppearance.Momo.Caption" />

                            <TextView
                                android:id="@+id/tvWaterOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_water_other"
                                android:textAppearance="@style/TextAppearance.Momo.Caption"
                                android:textColor="@color/accent_blue" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="1dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
      固定标题：不透明底色遮住滚动内容。
      颜色取了页面渐变的最上端，顶部和窗口背景无缝衔接；滚动后也保持同一底色，
      视觉上就是「标题浮在内容之上」，和截图一致。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_height"
        android:background="@color/bg_gradient_top">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.Momo.TitlePage" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/space_4"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                android:translationY="-6dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>