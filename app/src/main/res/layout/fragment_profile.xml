    <!-- 固定标题：不透明底遮住滚动内容，位置不随滚动移动 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/profile_header_height"
        android:background="@color/bg_gradient_top"
        android:paddingHorizontal="@dimen/screen_margin">

        <LinearLayout
