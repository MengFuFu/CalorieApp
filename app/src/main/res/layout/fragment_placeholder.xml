<?xml version="1.0" encoding="utf-8"?>
<!--
  M2 阶段所有 Tab 共用这一个布局，标题由各自的 Fragment 填。
  首页在 M6 会被整体换成真实布局，其余页面在 M8/M9/M14 逐步替换。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/tvPlaceholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Momo.TitlePage"
        tools:text="今日记录"
        xmlns:tools="http://schemas.android.com/tools" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Momo.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16">

        <TextView
            android:id="@+id/tvPlaceholderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/card_padding"
            android:text="@string/placeholder_hint"
            android:textAppearance="@style/TextAppearance.Momo.Body"
            android:textColor="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>