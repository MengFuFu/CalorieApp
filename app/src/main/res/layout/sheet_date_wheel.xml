<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_white"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_16">

    <!-- 标题行：日期 + 关闭 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/sheet_date_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="@dimen/space_6"
            android:src="@drawable/ic_close"
            app:tint="@color/text_tertiary" />
    </FrameLayout>

    <!-- 三列滚轮：等宽，垂直方向由 WheelPickerView 自己定高 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16">

        <com.mh.calorie.ui.widget.WheelPickerView
            android:id="@+id/wheelDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.mh.calorie.ui.widget.WheelPickerView
            android:id="@+id/wheelHour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.mh.calorie.ui.widget.WheelPickerView
            android:id="@+id/wheelMinute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirm"
        style="@style/Widget.Momo.Button.Pill.Filled"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/space_24"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/action_confirm"
        android:textSize="16sp" />
</LinearLayout>