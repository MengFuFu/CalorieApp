<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义底部栏。根节点用 merge：这个布局是由 MomoBottomBar 直接 inflate 到自己的，
  多套一层 FrameLayout 纯属浪费层级。

  布局思路：
    [左半区: 记录 计划]  [中间留 56dp 给 FAB]  [右半区: 统计 我的]
  左右两半各占剩余宽度的一半（weight=1），所以 4 个 Tab 视觉上是对称的，
  中间的空位正好让 FAB 压在上沿、不遮住任何图标。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:orientation="horizontal">

        <!-- ========== 左半区 ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabRecord"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconRecord"
                    android:layout_width="40dp"
                    android:layout_height="37.5dp"
                    android:contentDescription="@string/tab_record"
                    android:src="@drawable/ic_tab_record" />

                <TextView
                    android:id="@+id/labelRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_record"
                    android:textColor="@color/tab_tint"
                    android:textSize="@dimen/bottom_bar_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabPlan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconPlan"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/tab_plan"
                    android:src="@drawable/ic_tab_plan" />

                <TextView
                    android:id="@+id/labelPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/tab_plan"
                    android:textColor="@color/tab_tint"
                    android:textSize="@dimen/bottom_bar_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 中间：给 FAB 让位 ========== -->
        <FrameLayout
            android:layout_width="@dimen/fab_width"
            android:layout_height="match_parent" />

        <!-- ========== 右半区 ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconStats"
                    android:layout_width="32dp"
                    android:layout_height="27.4dp"
                    android:contentDescription="@string/tab_stats"
                    android:src="@drawable/ic_tab_stats" />

                <TextView
                    android:id="@+id/labelStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/tab_stats"
                    android:textColor="@color/tab_tint"
                    android:textSize="@dimen/bottom_bar_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconProfile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/tab_profile"
                    android:src="@drawable/ic_tab_profile" />

                <TextView
                    android:id="@+id/labelProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/tab_profile"
                    android:textColor="@color/tab_tint"
                    android:textSize="@dimen/bottom_bar_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
  加号：这不是 Material FAB，而是设计稿里那颗「浅绿 + 深色描边 + 深色加号」的胶囊。
  用 top + marginTop=4dp 而不是 gravity=center：底栏底部有系统导航条的 padding，
  gravity=center 会在「减去 padding 后的区域」里居中，和 Tab 的中线差半个 inset。
-->
    <FrameLayout
        android:id="@+id/fabAdd"
        android:layout_width="@dimen/fab_width"
        android:layout_height="@dimen/fab_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_fab_add"
        android:clickable="true"
        android:contentDescription="@string/ai_chat"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary" />
    </FrameLayout>
</merge>